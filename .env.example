# Google OAuth Configuration
# Get your Client ID from: https://console.cloud.google.com/
REACT_APP_GOOGLE_CLIENT_ID=

# Optional: API base URL for custom backend
# Leave empty for fully client-side operation
REACT_APP_API_BASE_URL=

# Optional: Feature flags
REACT_APP_ENABLE_GOOGLE_DRIVE=true
REACT_APP_ENABLE_COLLABORATIVE=false
REACT_APP_DEBUG_MODE=false
